{
    "keyGenerator": {
        "algorithm": { "type": "HASH", "length": 8 },
        "refreshOn": "TORRENT_PERSISTENT",
        "keyCase": "upper"
    },
    "peerIdGenerator": {
        "algorithm": { "type": "REGEX", "pattern": "-TR4050-[A-Za-z0-9]{12}" },
        "refreshOn": "NEVER",
        "shouldUrlEncode": false
    },
    "urlEncoder": {
        "encodingExclusionPattern": "[A-Za-z0-9.\\-_~]",
        "encodedHexCase": "upper"
    },
    "query": "info_hash={infohash}&peer_id={peerid}&port={port}&uploaded={uploaded}&downloaded={downloaded}&left={left}&numwant={numwant}&key={key}&compact=1&supportcrypto=1&event={event}",
    "numwant": 80,
    "numwantOnStop": 0,
    "requestHeaders": [
        { "name": "User-Agent", "value": "Transmission/4.0.5" }
    ]
}
